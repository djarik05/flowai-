# GestureFlow AI Backend - Environment Configuration
# Copy this file to .env and customize as needed
# NEVER commit .env files with real secrets

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=GestureFlow AI
APP_VERSION=1.0.0
ENVIRONMENT=development  # development, production, staging

# =============================================================================
# API SETTINGS
# =============================================================================
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_DIR=logs

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Comma-separated list of allowed origins for CORS
# Default includes Vite development server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend development URL (used for reference)
FRONTEND_DEV_URL=http://localhost:5173

# =============================================================================
# CAMERA SETTINGS
# =============================================================================
# Camera device index (0 = default laptop webcam)
CAMERA_INDEX=0
# Requested frame dimensions (camera may not support all resolutions)
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
# Requested frame rate (camera may not support all rates)
CAMERA_FPS=30
# Mirror frames horizontally (useful for front-facing cameras)
CAMERA_MIRROR=true
# OpenCV backend (empty = auto, or specify: CAP_DSHOW, CAP_V4L2, CAP_MSMF)
CAMERA_BACKEND=
# Camera initialization timeout in seconds
CAMERA_INIT_TIMEOUT=5.0

# =============================================================================
# HAND TRACKING SETTINGS
# =============================================================================
# Maximum number of hands to track (1-4)
TRACKING_MAX_HANDS=2
# Minimum detection confidence (0.1-1.0)
TRACKING_DETECTION_CONFIDENCE=0.7
# Minimum tracking confidence (0.1-1.0)
TRACKING_TRACKING_CONFIDENCE=0.5
# MediaPipe model complexity (0=lite, 1=full, 2=heavy)
TRACKING_MODEL_COMPLEXITY=1

# =============================================================================
# HAND LANDMARKER MODEL
# =============================================================================
# Path to the MediaPipe Hand Landmarker model (.task file).
# Relative paths are resolved from the backend project directory.
# Official download: https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task
HAND_LANDMARKER_MODEL_PATH=models/hand_landmarker.task